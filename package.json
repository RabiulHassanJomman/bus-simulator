{
  "name": "dhaka-bus-simulator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "data:build": "node --max-old-space-size=8192 --import tsx tools/build.ts",
    "data:fetch": "tsx tools/fetch.ts",
    "data:validate": "tsx tools/validate.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "earcut": "^3.2.4",
    "pixi.js": "^8.22.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.13",
    "@types/earcut": "^3.0.0",
    "@types/node": "^26.6.5",
    "puppeteer-core": "^25.16.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
